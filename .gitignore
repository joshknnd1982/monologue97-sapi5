# Build trees, staging and the compiled installer. Everything here is
# regenerated by build_all.bat; the ready-to-run binaries are committed under
# prebuilt/ instead, and the installer is published on the Releases page.
build_x86/
build_x64/
output/
dist/

# Compiler leftovers, wherever they land
*.obj
*.ilk
*.pdb
*.exp
*.lib
*.idb
*.tlog
*.raw

# The original Monologue '97 CD image. Not tracked: none of it -- SETUP.EXE,
# the electronic-registration tool, the compressed .Z archives, the help file --
# is needed to build or run anything here. The engine files that *are* needed
# have been extracted into engine/.
bin/

# --- not part of this project ---------------------------------------------
# This working directory is reused between speech-engine projects, so files
# from earlier ones can still be sitting here. They are left on disk untouched
# and simply kept out of this repository.
src/IEnumSpObjectTokensImpl.*
src/ISpDataKeyImpl.*
src/ISpTTSEngineImpl.*
src/b32_wrapper.*
src/bestspeech_sapi.def
src/bestspeech_server.cpp
src/com.*
src/debug_log.h
src/pipe_client.*
src/pipe_protocol.h
src/registry.*
src/sapi_main.cpp
src/utils.hpp
src/voice_attributes.hpp
src/voice_token.*
installer/innosetup_code.iss
installer/post_process_iss.cmake

# Probe scratch binaries (the probe sources are tracked; their builds are not)
tools/probe/*.exe
tools/*.exe

# The samples zip is a release asset; the individual WAVs are tracked instead.
samples/*.zip

# Scratch output directories from ad-hoc test runs
out/
out_final/
